SECRET_KEY=your-django-secret-key
DATABASE_URL=postgres://user:password@localhost:5432/produit_db
DEBUG=False

# Email Service
EMAIL_BACKEND=anymail.backends.sendinblue.EmailBackend
BREVO_API_KEY=your-brevo-api-key

# Hosts & CORS
CORS_ALLOWED_ORIGINS=https://produitacademy.com,https://classes.produitacademy.com,https://gate.produitacademy.com,https://careers.produitacademy.com,https://staff.produitacademy.com
ALLOWED_HOSTS=produitacademy.com,classes.produitacademy.com,gate.produitacademy.com,careers.produitacademy.com,staff.produitacademy.com,localhost,127.0.0.1

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_URL=

# SSL & Production Security Flags
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True